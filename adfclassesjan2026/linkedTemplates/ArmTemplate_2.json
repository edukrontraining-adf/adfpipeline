							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT TABLE_SCHEMA, TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE='BASE TABLE'",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_bulk_load_azuresql",
								"type": "DatasetReference",
								"parameters": {
									"TableName": "tablename"
								}
							},
							"firstRowOnly": false
