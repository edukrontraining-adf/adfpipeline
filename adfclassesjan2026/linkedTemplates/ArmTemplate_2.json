							"items": {
								"value": "@activity('LookupTables').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 5,
							"activities": [
								{
									"name": "CopyEachTableToBlob",
									"type": "Copy",
									"dependsOn": [],
