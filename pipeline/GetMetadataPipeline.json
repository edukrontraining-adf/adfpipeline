{
	"name": "GetMetadataPipeline",
	"properties": {
		"activities": [
			{
				"name": "GetFileMetadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_AzureSqlTable",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"columnCount",
						"structure"
					]
				}
			},
			{
				"name": "ShowMetadataOutput",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetFileMetadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "metadataOutput",
					"value": {
						"value": "@string(activity('GetFileMetadata').output)",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"metadataOutput": {
				"type": "String"
			}
		},
		"folder": {
			"name": "1-10 Scenarios"
		},
		"annotations": []
	}
}