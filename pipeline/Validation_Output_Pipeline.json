{
	"name": "Validation_Output_Pipeline",
	"properties": {
		"activities": [
			{
				"name": "Validate_File",
				"type": "Validation",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_delete_activity",
						"type": "DatasetReference"
					},
					"timeout": "00:10:00",
					"sleep": 10
				}
			},
			{
				"name": "Check file Status",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Validate_File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"ifFalseActivities": [
						{
							"name": "Sent Email Notification",
							"type": "WebHook",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"timeout": "00:10:00"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Move files from blob to sqlserver",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"enableStaging": false
							}
						}
					]
				}
			}
		],
		"variables": {
			"validationOutput": {
				"type": "String"
			}
		},
		"annotations": []
	}
}