{
	"name": "ds_blobstorage",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_azureblob",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"FileName": {
				"type": "string",
				"defaultValue": "@dataset().FileName"
			}
		},
		"folder": {
			"name": "old datasets"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@CONCAT('Incremental-', pipeline().RunId, '.txt')",
					"type": "Expression"
				},
				"container": "destination"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}